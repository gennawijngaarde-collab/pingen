# ==========================================
# PinGen - Example environment variables
# Copy to .env and fill in real values
# ==========================================

# --- Supabase (optional — without it, local demo mode) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- OpenRouter (texte, vision) — pas d'OpenAI / VITE_OPENAI ---
# https://openrouter.ai/keys
# Préférez OPENROUTER_API_KEY (non exposée au navigateur).
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Ideogram (images de Pins) ---
# https://developer.ideogram.ai
# IDEOGRAM_API_KEY=

# --- Resend (emails) ---
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# RESEND_FROM=PinGen <contact@pingenx.io>
# ADMIN_EMAIL=genna.wijngaarde@gmail.com

# --- Pinterest ---
# Create app: https://developers.pinterest.com/apps/
# Website (formulaire Connect app) : https://www.pingenx.io
# Redirect URI locale : http://localhost:5173/dashboard/settings
# Redirect URI prod : https://www.pingenx.io/dashboard/settings
# VITE_PINTEREST_APP_ID=1607362
# PINTEREST_APP_SECRET=

# --- Stripe (paiements Pro 19€ / Business 49€) ---
# https://dashboard.stripe.com/apikeys
# Préférez STRIPE_SECRET_KEY (non exposée au navigateur).
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# --- App ---
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=PinGen
