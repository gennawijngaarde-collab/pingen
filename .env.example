# ==========================================
# PinGen - Example environment variables
# Copy to .env and fill in real values
# ==========================================

# --- Supabase (optional — without it, local demo mode) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- OpenRouter (texte, vision) — pas d'OpenAI / VITE_OPENAI ---
# https://openrouter.ai/keys
# Préférez OPENROUTER_API_KEY (non exposée au navigateur).
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Grok Image (xAI - images de Pins) ---
# https://x.ai/api
# GROK_API_KEY=xai-...
# ou
# XAI_API_KEY=xai-...

# --- Resend (emails) ---
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# RESEND_FROM=PinGen <contact@pingenx.io>
# Signup notifications recipient (defaults to the first account created)
# ADMIN_EMAIL=admin@example.com

# --- Pinterest ---
# Create app: https://developers.pinterest.com/apps/
# Website (formulaire Connect app) : https://www.pingenx.io
# Redirect URI locale : http://localhost:5173/dashboard/settings
# Redirect URI prod : https://www.pingenx.io/dashboard/settings
# VITE_PINTEREST_APP_ID=1609578
# PINTEREST_APP_SECRET=

# --- Stripe (paiements Pro 19€ / Business 49€) ---
# https://dashboard.stripe.com/apikeys
# Préférez STRIPE_SECRET_KEY (non exposée au navigateur).
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# --- Server-only secrets (Vercel → Settings → Environment Variables) ---
# Supabase service role: automated publisher + billing writes (never VITE_)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Secret sent by Vercel Cron to /api/cron/publish-scheduled-pins (openssl rand -base64 32).
# GitHub Actions authenticates with OIDC instead, no shared secret needed.
# CRON_SECRET=
# Optional: the Stripe webhook endpoint is provisioned automatically and events are
# verified by re-fetching them from Stripe. Set this to add HMAC signature checks too.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Monitoring (optional, see INFRA.md) ---
# Sentry: one project "genx-web" (browser) and one "genx-api" (Vercel functions).
# SENTRY_DSN=https://...@o0.ingest.de.sentry.io/0          # server functions
# VITE_SENTRY_DSN=https://...@o0.ingest.de.sentry.io/0     # browser
# PostHog (EU cloud, cookieless, identified users only)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- App ---
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=PinGen
