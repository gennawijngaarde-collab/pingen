# ==========================================
# PinGen - Example environment variables
# Copy to .env and fill in real values
# ==========================================

# --- Supabase (optional — without it, local demo mode) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- OpenAI ---
# VITE_OPENAI_API_KEY=sk-...

# --- Pinterest ---
# Create app: https://developers.pinterest.com/apps/
# Redirect URI: http://localhost:5173/dashboard/settings
# VITE_PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=

# --- Stripe (optional) ---
# VITE_STRIPE_PUBLISHABLE_KEY=pk_...

# --- App ---
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=PinGen
